# 本工程自定义组件的注册文件
# 注意：ESP-IDF 会把 <项目>/components 这个目录本身注册成一个名为 "components" 的组件，
#       下面的 SRC_DIRS/INCLUDE_DIRS 都是相对本文件所在目录的路径。

set(src_dirs
            photo)

set(include_dirs
            photo)

set(requires
            driver
            esp_timer
            esp_driver_i2c
            esp_driver_ledc
            esp32-camera)

idf_component_register(SRC_DIRS ${src_dirs} INCLUDE_DIRS ${include_dirs} REQUIRES ${requires})

component_compile_options(-O3)
